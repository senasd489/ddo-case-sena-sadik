# --- PostgreSQL ---
POSTGRES_USER=enerjihat
POSTGRES_PASSWORD=enerjihat_dev_pw
POSTGRES_DB=enerjihat

# --- API ---
# En az 32 karakter. Üretimde mutlaka değiştirin.
JWT_SECRET=change-me-please-this-is-a-dev-secret-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
REQUEST_TIMEOUT=30s
LOG_LEVEL=info
# Simülatör / sayaç veri toplama sisteminin (head-end) makineden makineye anahtarı
INGEST_TOKEN=dev-ingest-token-change-me-0123456789

# --- Seed + Simülatör (aynı tohum → aynı veri) ---
SEED_SUBSCRIBERS=5000
SIM_SEED=42
# Simülatör önce bu kadar geçmişi hızla gönderir, sonra gerçek zamanlı akar
SIM_BACKFILL=48h
# Rastgele arıza aralığı (gerçek zaman)
SIM_OUTAGE_EVERY=3m
# Sabit "bugün" (YYYY-MM-DD). Boş = çalıştırma günü. Aynı tohum + aynı tarih → birebir aynı veri.
SIM_ANCHOR=
